<body>


    @*for dropdown of userInfo*@

    <script>
        function menuToggle() {
            const toggleMenu = document.querySelector(".menu");
            toggleMenu.classList.toggle("active");
        }

        $(document).on('click', '.sl-nav', function () {
            $('.menu').removeClass('active');
        });
    </script>

    @*for dropdown of userInfo*@



    <script>

        function openRightSideNav() {

            jQuery(".rightSideBar ").addClass("RightSideShow");
            jQuery("#overlayRight").addClass("overlayRight");
            jQuery("#noOverflow").addClass("noOverflow");

        }

        function RightcloseSideNav() {

            jQuery(".rightSideBar ").removeClass("RightSideShow");
            jQuery("#overlayRight").removeClass("overlayRight");
            jQuery("#noOverflow").removeClass("noOverflow");

        }
    </script>

    <script>

        function openSideNav() {

            jQuery("#side-menu").addClass("aside-show");
            jQuery("#overlay").addClass("overlay");
            jQuery("#noOverflow").addClass("noOverflow");
        }

        function closeSideNav() {

            jQuery("#side-menu").removeClass("aside-show");
            jQuery("#overlay").removeClass("overlay");
            jQuery("#noOverflow").removeClass("noOverflow");
        }

    </script>
    @*for small scrreen search bar*@
    <script>

        function openSearchBar() {

            jQuery("#SmallScreenSearchBox").addClass("SmallScreenSearchBox");
            jQuery("#closeSearchBox").addClass("closeSearchBox");
        }
        function closeSearchBox() {

            jQuery("#SmallScreenSearchBox").removeClass("SmallScreenSearchBox");
            jQuery("#closeSearchBox").removeClass("closeSearchBox");
        }

    </script>


    @*for small scrreen search bar*@



    <div id="closeSearchBox" onclick="closeSearchBox()"></div>
    <div id="overlayRight" onclick="RightcloseSideNav()"></div>
    <div id="overlay" onclick="closeSideNav()"></div>


