
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/Account_Layout.cshtml";
}
<link href="~/Account_styling/Account_Index.css" rel="stylesheet" />


<div class="container-fluid px-0">
    <div class="row">
        <div class="col-lg-6 px-0 img">
            <div class="d-flex align-items-center justify-content-center" style="background-color: transparent; height: 100vh;">
                <div class="d-flex align-items-center flex-column ">

                    <img src="~/images/loginimg.svg" width="500px" class="img-fluid" style="margin-top:5rem;" data-aos="zoom-out" />

                </div>
            </div>
        </div>
        
        <div class="col-lg-6 px-lg-0 px-3 position-relative" style="background:url(../../images/accoutnbackimg.png) center center no-repeat; width:100%;height:100%;background-size:cover;">
            <form method="post" action="@Url.Action("login", "Account")">
                <div class="d-flex align-items-center justify-content-center position-relative" style=" height: 100%;">

                    <div class="w-100 d-flex align-items-center justify-content-center px-sm-0 px-3" style="height:100vh; " data-aos="zoom-in">

                        <div id="form" class="d-flex align-items-center flex-column w-100 form h-100 justify-content-center">

                            <h3 class="login-head mb-5">
                                Login
                            </h3>
                            <div class="form-item" style="color:red">
                                @TempData["message"]
                               
                            </div>
                            <div class="form-item">
                                <input type="email" name="_email" id="email" class="form-style" autocomplete="off" value="@ViewBag.Email" placeholder="Ingresa tu email" required />
                            </div>
                            <div class="form-item">
                                <input type="password" name="_password" id="password" class="form-style" placeholder="Contraseña" required />


                                <p class="mt-2">
                                    <a href="#" style="color: #025599; font-size: 16px; font-weight: 400; line-height: 19px; letter-spacing: 0em; text-align: left; ">
                                        <small>
                                            Forgot Password ?
                                        </small>
                                    </a>
                                </p>
                            </div>
                            <div class="form-item mt-4 mb-3">

                                <a class="form-item">
                                    <input type="submit" class="login pull-right" value="Login" required>
                                </a>
                            </div>

                            <div>
                                <p class=" text-capitalize" style="color: #797979; font-size: 16px; font-weight: 400; line-height: 19px; letter-spacing: 0em; text-align: left; ">
                                    ¿Todavía no tienes una cuenta?
                                    <a href="@Url.Action("SignUp","Account")" style="color: #025599;">
                                        ¡Regístrate ahora!
                                    </a>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
           
        </div>
    </div>

</div>


