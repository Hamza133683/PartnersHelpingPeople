<div class="container-fluid contactWidth" id="Contact">
    <div class="row">
        <div class="col-md-6 d-flex align-items-center justify-content-center">

            <img src="~/images/phone 1.svg" class="img-fluid" width="400px" data-aos="fade-up" />

        </div>
        <div class="col-md-6 mt-md-0 mt-4 px-0">
            <div class="d-flex flex-column align-items-start mt-md-4">
                <p class="contact-para mb-3" data-aos="fade-down">
                    Contáctanos
                </p>
                <h3 class="contact-head mb-0" data-aos="fade-down">
                    Si tienes preguntas o si
                </h3>
                <h3 class="contact-head mb-3" data-aos="fade-down">

                    necesitas soporte déjanos saber.
                </h3>
            </div>
            <form data-aos="fade-up">
                <div class="form-item">
                    <input type="text" name="FirstName" id="FirstName" class="form-style" autocomplete="off" placeholder="nombre" required />
                </div>
                <div class="form-item">
                    <input type="text" name="LastName" id="LastName" class="form-style" autocomplete="off" placeholder="apellido" required />
                </div>
                <div class="form-item">
                    <input type="email" name="email" id="email" class="form-style" autocomplete="off" placeholder="Correo electrónico" required />
                </div>

                <textarea placeholder="Mensaje"></textarea>

                <button class="sendBtn">
                    ENVIAR
                </button>
            </form>
        </div>
    </div>
</div>
