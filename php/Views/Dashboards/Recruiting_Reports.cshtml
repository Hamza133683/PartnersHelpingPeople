@*modal to add videos*@

<div class="modal fade" id="exampleModalCenter" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content pb-5 pt-3" style="border-radius:2px;">
            <div class="px-3 pb-3">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <img src="~/images/Cancel.svg" />
                </button>
            </div>
            <div class="d-flex justify-content-center">
                <h3 class="modal-head">
                    New Video
                </h3>
            </div>

            <div class="px-3 py-5">
               

                <div class="d-flex align-items-center justify-content-between w-100">
                    <div class="form-item">
                        <input type="text" class="form-style" autocomplete="off" placeholder="number of people" style="max-width:unset;" />
                    </div>

                </div>
                
                <div class="d-flex align-items-center justify-content-between w-100">
                    <div class="form-item">
                        <input type="text" class="form-style" autocomplete="off" placeholder="number of interviews" style="max-width:unset;" />
                    </div>

                </div>
                
                <div class="d-flex align-items-center justify-content-between w-100">
                    <div class="form-item">
                        <input type="text" class="form-style" autocomplete="off" placeholder="number of hires" style="max-width:unset;" />
                    </div>

                </div>

            </div>
            <div class="d-flex justify-content-center ">
                <button class="add-btn" style="padding:5px 30px;">
                  invite
                </button>
            </div>
        </div>
    </div>
</div>


