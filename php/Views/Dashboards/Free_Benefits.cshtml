
@{
    ViewBag.Title = "Free_Benefits";
    Layout = "~/Views/Shared/Dashboards_Layout.cshtml";
}

<link href="~/Dashboard-styling/Free_Benefits.css" rel="stylesheet" />
<link href="~/Dashboard-styling/bars_Stylings.css" rel="stylesheet" />

<link href="~/dflip/css/dflip.min.css" rel="stylesheet" type="text/css">
<link href="~/dflip/css/themify-icons.min.css" rel="stylesheet" />


<div class="container-fluid px-0" style="height:100%;">
    <div class="row w-100 mx-0" style="height:100%;">
        <div class=" col-12 px-0  center-back">
            @*main page and date*@
            <div class="container-fluid mt-3 multiple-cards px-2">
                <div class="row mx-0">
                    <div class="col-md-4 col-sm-6 col-12">
                        <figure>
                            <a href="#" data-backdrop="static" data-toggle="modal" data-target="#exampleModalCenter">
                                <img src="~/images/freebenfitsimgs (6).png" />
                            </a>
                            <figcaption class="card-caption">
                                <h6 class="card-head">
                                    Child Safe Kit
                                </h6>

                                <div class="d-flex align-items-center justify-content-end">
                                    <button class="fig-btn" type="button" data-toggle="modal" data-target="#exampleModalCenter">
                                        open up
                                    </button>
                                </div>
                            </figcaption>
                        </figure>
                    </div>
                    <div class="col-md-4 col-sm-6 col-12">
                        <figure>
                            <img src="~/images/freebenfitsimgs (5).png" />

                            <figcaption class="card-caption">
                                <h6 class="card-head">
                                    Free Will & Testament
                                </h6>

                                <div class="d-flex align-items-center justify-content-end">
                                    <button class="fig-btn" type="button" data-toggle="modal" data-target="#exampleModalCenter1">
                                        open up
                                    </button>
                                </div>
                            </figcaption>
                        </figure>
                    </div>
                    <div class="col-md-4 col-sm-6 col-12">
                        <figure>
                            <img src="~/images/freebenfitsimgs (4).png" />

                            <figcaption class="card-caption">
                                <h6 class="card-head">
                                    Discount Card
                                </h6>

                                <div class="d-flex align-items-center justify-content-end">
                                    <button class="fig-btn"  type="button" data-toggle="modal" data-target="#exampleModalCenter2">
                                        open up
                                    </button>
                                </div>
                            </figcaption>
                        </figure>
                    </div>
                    <div class="col-md-4 col-sm-6 col-12">
                        <figure>
                            <img src="~/images/freebenfitsimgs (3).png" />

                            <figcaption class="card-caption">
                                <h6 class="card-head">
                                    Legacy Rewards
                                </h6>

                                <div class="d-flex align-items-center justify-content-end">
                                    <button class="fig-btn"  type="button" data-toggle="modal" data-target="#exampleModalCenter3">
                                        open up
                                    </button>
                                </div>
                            </figcaption>
                        </figure>
                    </div>
                    <div class="col-md-4 col-sm-6 col-12">
                        <figure>
                            <img src="~/images/freebenfitsimgs (2).png" />

                            <figcaption class="card-caption">
                                <h6 class="card-head">
                                    Family Information Guide
                                </h6>

                                <div class="d-flex align-items-center justify-content-end">
                                    <button class="fig-btn" type="button" data-toggle="modal" data-target="#exampleModalCenter4">
                                        open up
                                    </button>
                                </div>
                            </figcaption>
                        </figure>
                    </div>
                    <div class="col-md-4 col-sm-6 col-12">
                        <figure>
                            <img src="~/images/freebenfitsimgs (1).png" />

                            <figcaption class="card-caption">
                                <h6 class="card-head">
                                    A&D Policy
                                </h6>

                                <div class="d-flex align-items-center justify-content-end">
                                    <button class="fig-btn" type="button" data-toggle="modal" data-target="#exampleModalCenter5">
                                        open up
                                    </button>
                                </div>
                            </figcaption>
                        </figure>
                    </div>


                </div>
            </div>
            @*main page and date*@
        </div>
    </div>
</div>







<div class="modal fade" id="exampleModalCenter" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content" style="">
            <div style="position:relative;width:100%;">
                <div style="position:absolute;z-index:2;right:0;top:0;">
                    <button type="button" class="close mt-2 mr-3" data-dismiss="modal" aria-label="Close">
                        <img src="~/images/Cancel.svg" />
                    </button>
                </div>
            </div>
            <div class="_df_book" id="flipbok_example" source="~/pdfs/Child Safe Kit Canada.pdf">

            </div>
        </div>
    </div>
</div>

