@*modal to add videos*@

<div class="modal fade" id="exampleModalCenter" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content pb-5 pt-3" style="border-radius:2px;">
            <div class="px-3 pb-3">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <img src="~/images/Cancel.svg" />
                </button>
            </div>
            <div class="d-flex justify-content-center">
                <h3 class="modal-head">
                    New Video
                </h3>
            </div>

            <div class="px-3 py-5">
                <div class="form-item mr-3">
                    <label class="form-control d-flex justify-content-start align-items-center form-style" for="file-name" style="border:none; background-color:transparent;margin-bottom:1rem;">
                        <span class="file-span">Profile Picture</span>
                    </label>
                    <input type="file" class="form-control form-style" id="file-name" onchange="pressed()" style="position:absolute;top:0;z-index:0;" />

                </div>

                <div class="d-flex align-items-center justify-content-between w-100">
                    <div class="form-item">
                        <input type="text" class="form-style" autocomplete="off" placeholder="Appointments" style="max-width:unset;" />
                    </div>

                </div>

            </div>
            <div class="d-flex justify-content-center ">
                <button class="add-btn" style="padding:5px 30px;">
                    Add Now
                </button>
            </div>
        </div>
    </div>
</div>


