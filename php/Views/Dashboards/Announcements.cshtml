
@{
    ViewBag.Title = "Announcements";
    Layout = "~/Views/Shared/Dashboards_Layout.cshtml";
}

<link href="~/Dashboard-styling/bars_Stylings.css" rel="stylesheet" />
<link href="~/Dashboard-styling/Announcements.css" rel="stylesheet" />


<div class="container-fluid containWidth">
    <div class="row">
        <div class="col-lg-12 order-0">

            <div id="carouselExampleIndicators" class="carousel slide" data-ride="carousel" style="height:100%;">
                <ol class="carousel-indicators hero-indicators">
                    <li data-target="#carouselExampleIndicators" data-slide-to="0" class="active"></li>
                    <li data-target="#carouselExampleIndicators" data-slide-to="1"></li>
                    <li data-target="#carouselExampleIndicators" data-slide-to="2"></li>
                </ol>
                <div class="carousel-inner " style="height:100%;">
                    <div class="carousel-item active">
                        <img src="~/images/announceCaroImages (1).png" alt="...">
                        <div class="carousel-caption ">
                            <h5 class="caro-head">Conoce el nuevo formulario de residencia en la plataforma Eapp</h5>
                            <p class="caro-para">Nos complace anunciar la llegada del nuevo formulario de residencia en nuestra plataforma Eapp. Esta innovadora actualización trae consigo una serie de beneficios que impactan positivamente la calificación de más individuos. Exploremos cómo los nuevos formularios de residencia revolucionan el proceso y crean oportunidades para una mayor inclusión y elegibilidad.</p>
                        </div>
                        <div class="btn-flow">
                            <button class="caro-btn">
                                join Now
                            </button>
                        </div>
                    </div>
                    <div class="carousel-item">
                        <img src="~/images/announceCaroImages (2).png" alt="...">
                        <div class="carousel-caption ">
                            <h5 class="caro-head">¡Nuevos videos de capacitación previa a la licencia (Curso de ExamFX!)</h5>
                            <p class="caro-para">Este recurso invaluable está diseñado para ayudar a los nuevos candidatos contratados a obtener su licencia de seguros de vida de manera eficiente y efectiva, todo en un lugar accesible y conveniente.</p>
                        </div>
                        <div class="btn-flow">
                            <button class="caro-btn">
                                join Now
                            </button>
                        </div>
                    </div>
                    <div class="carousel-item">
                        <img src="~/images/announceCaroImages (3).png" alt="...">
                        <div class="carousel-caption ">
                            <h5 class="caro-head">Descubre el poder del programa de Legacy Rewards</h5>
                            <p class="caro-para">Mejora tus ventas con una herramienta excepcional. Desbloquea el potencial de nuestro programa de recompensas Legacy, impulsado por Quintero & Partners, y lleva tus ventas a nuevas alturas con este recurso invaluable.</p>
                        </div>
                        <div class="btn-flow">
                            <button class="caro-btn">
                                join Now
                            </button>
                        </div>
                    </div>
                </div>

            </div>


        </div>
    </div>
</div>


<div class="container-fluid pt-1 containWidth">
    <div class="row">

        <div class="col-12 mb-md-1 mt-2 px-2">
            <div class="announ-bar">
                All Annoucements
            </div>
        </div>

        <div class="col-md-3 col-sm-6 col-12 mt-md-2 mt-3">
            <figure>
                <img src="~/images/announImages (3).png" />
                <figcaption class="card-caption">
                    <div>
                        <h2 class="card-head mb-1">
                            Primer State General Agent (SGA) promovido por Quintero & Partners con Continuo Apoyo de QP:
                        </h2>
                        <p class="card-para">
                            Nos complace anunciar a Klyo como nueva SGA dentro de Quintero & Partners, marcando un logro significativo para nuestra organización.
                        </p>
                    </div>

                    <button class="fig-btn">
                        Mas informacion
                    </button>

                </figcaption>
            </figure>
        </div>
        <div class="col-md-3 col-sm-6 col-12 mt-md-2 mt-3">
            <figure>
                <img src="~/images/announImages (2).png" />

                <figcaption class="card-caption">
                    <h2 class="card-head mb-1">
                        Descubre tus productos favoritos de AIL y Globe Life en la tienda GL
                    </h2>
                    <p class="card-para">
                        Disfruta de la experiencia de comprar tu mercancía preferida de AIL y Globe Life en la tienda GL
                    </p>


                    <button class="fig-btn">
                        Mas informacion
                    </button>

                </figcaption>
            </figure>
        </div>
        <div class="col-md-3 col-sm-6 col-12 mt-md-2 mt-3">
            <figure>
                <img src="~/images/announImages (1).png" />

                <figcaption class="card-caption">
                    <h2 class="card-head mb-1">
                        No te pierdas nuestras sesiones de educación continua
                    </h2>
                    <p class="card-para">
                        Mantente informado e inspirado al participar en nuestras interesantes sesiones de educación continua. Todos los miércoles, te presentamos líderes influyentes de nuestra industria que compartirán tácticas valiosas y lecciones para ayudarte a sobresalir en tu carrera en Quintero & Partners.
                    </p>


                    <button class="fig-btn">
                        Mas informacion
                    </button>

                </figcaption>
            </figure>
        </div>
        


    </div>
</div>





