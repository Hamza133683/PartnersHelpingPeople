
@{
    ViewBag.Title = "Documents";
    Layout = "~/Views/Shared/Dashboards_Layout.cshtml";
}


<link href="~/Dashboard-styling/Documents.css" rel="stylesheet" />
<link href="~/Dashboard-styling/bars_Stylings.css" rel="stylesheet" />


<div class="ml-3">
    <img src="~/images/Translation.svg" style="width:25px" />
    <span style="font-size: 14px; font-weight: 400; line-height: 29px; letter-spacing: 0em; text-align: left; color: #797979; ">
        Spanish
    </span>
</div>




<div class="container-fluid px-0" style="height:100%;">
