    </div>
</div>


<div class="col-12 px-4">

    <div class="wrapper">
        <div class="form-content">
            <form action="#">
                <div id="wizard">
                    <!-- SECTION 1 -->
                    <h4></h4>
                    <div>
                        <section id="section1">
