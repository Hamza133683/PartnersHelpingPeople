<script src="~/jquery 3.3/jquery-3.3.1.min.js"></script>
<script>

    $(document).ready(function ()
    {
       /* targetElement.prop("selectedIndex", index);*/

        var html = localStorage.getItem('FPPViewHtml');
        $('#appendhtml').html(html);

        var selectedValues = localStorage.getItem('SelectedValues');
        var selectedValuesid = localStorage.getItem('SelectedValuesId');
        var InputValues = localStorage.getItem('InputValues');
        var InputValuesId = localStorage.getItem('InputValuesId');

        InputValues = InputValues.split(',');
        InputValuesId = InputValuesId.split(',');

        selectedValues = selectedValues.split(',');
        selectedValuesid = selectedValuesid.split(',');
        var count = 0;
        for (var s = 1; s < selectedValuesid.length; s++) 
        {
            var index = selectedValues[s];
            var id = selectedValuesid[s];
            if (index && id != "" && index && id != null && index && id != undefined)
            {
                $('#' + id).prop("selectedIndex", index);
                $('#' + id).prop('disabled', true);
            }
        }
       

        for (var s = 3; s < InputValuesId.length; s++)
        {
            var value = InputValues[s];
            var inputId = InputValuesId[s];
            if (value && inputId != "" && value && inputId != null && value && inputId != undefined) {
                $('#' + inputId).val(value);
                $('#' + inputId).prop('disabled', true);
            }
        }
        $('.tr-hover-class').click(function ()
        {
            if ($(this).hasClass('rowselected'))
            {
                $('.tr-hover-class').removeClass('rowselected');
            }
            else
            {
                $('.tr-hover-class').removeClass('rowselected');
                $('.tr-hover-class').find('select').css('background-color', '');
                $(this).addClass('rowselected');
                $(this).find('select').css('background-color', '#FFF3C7');
            }
        });
        $('.td-coloumn-class').click(function ()
        {
            if ($(this).hasClass('rowselected'))
            {
                $('.td-coloumn-class').removeClass('rowselected');
            }
            else
            {
                $('.td-coloumn-class').removeClass('rowselected');
                $('.td-coloumn-class').find('select').css('background-color', '');
                $(this).addClass('rowselected');
                $(this).find('select').css('background-color', '#FFF3C7');
                
            }
        });



        
    });
    function coloumnhighlight(id1,id2,id3)
    {
        $('#' + id1).find('select').css('background-color', '');

        $('#'+id1).css('background-color', '');
        $('#'+id2).css('background-color', '');
        $('#'+id3).css('background-color', '');
        $('#' + id1).addClass('rowselected');
        $('#' + id2).addClass('rowselected');
        $('#' + id3).addClass('rowselected');

    }
</script>