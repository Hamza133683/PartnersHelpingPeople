
@{
    ViewBag.Title = "About_Us";
    Layout = "~/Views/Shared/Presentation_Layout.cshtml";
}





<link href="~/Presentation-Styling/About-Us.css" rel="stylesheet" />
<link href="~/Presentation-Styling/Presentaion-Bar-styling.css" rel="stylesheet" />



<div class="col-12 px-4">

    <div class="box ">

        <div class="container-fluid pr-md-0">
            <div class="row">
                <div class="col-md-6 d-flex align-items-center justify-content-md-center py-3">
                    <div class="d-flex flex-column align-items-start" style="max-width:470px;">

                        <h5 class="about-us-head">
                            Sobre Nosotros
                        </h5>
                        <h1 class="about-us-head1">
                            Quintero & Partners se ha convertido en la firma de más rápido
                        </h1>
                        <p class="about-us-para">
                            Quintero & Partners se ha convertido en la firma de más rápido crecimiento representando a American Income Life de Globe Life.
                        </p>
                        <p class="about-us-para">
                            Somos una firma financiera de propiedad independiente ubicada en Miami y Orlando, Florida. Nos enorgullece tener más de 160 miembros en nuestro equipo los cuales tienen pasión por hacer la diferencia.
                        </p>
                        <p class="about-us-para">
                            En Quintero & Partners, crecemos juntos, aprendemos todos los días, reconocemos los talentos únicos de nuestra gente y ofrecemos el mejor lugar para alcanzar los objetivos profesionales.
                        </p>


                    </div>
                </div>
                <div class="col-md-6 ">
                    <div>
                        <img src="~/images/prese-about-us-img.svg" width="100%" class="img-fluid" />
                    </div>
                </div>
            </div>
        </div>



        <div class="container-fluid SingleCard ">
            <div class="row d-flex align-items-center justify-content-center">
                <img src="~/images/globalLifecardImages.png" width="800px" class="img-fluid" />
            </div>

            <p class="about-us-para my-4 text-center mx-auto" style="max-width:800px">
                Globe Life es una corporación de servicios financieros que cotiza en la Bolsa de Valores de Nueva York y que opera a través de sus subsidiarias de propiedad total que ofrecen productos de protección. La empresa tiene su sede en McKinney, Texas.
            </p>
        </div>


    </div>


</div>









